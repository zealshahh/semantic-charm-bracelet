# Optional. Without a key the app runs in offline "lexical" mode.
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MIN=20
# Min cosine similarity to accept a match (defaults: 0.2 lexical, 0.5 gemini)
MIN_SCORE=
